{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // One Worker on workers.dev: the notes SPA (static assets), the OAuth 2.1
  // authorization server for agent connections, and the MCP endpoint.
  "name": "palladian",
  "main": "src/index.ts",
  // The newest date the pinned wrangler/workerd (1.20260908.1) supports.
  "compatibility_date": "2026-09-08",
  // global_fetch_strictly_public: required by the OAuth provider for Client ID
  // Metadata Documents (SSRF protection on outbound metadata fetches).
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../notes/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the paths the Worker owns; everything else is served straight from assets.
    "run_worker_first": [
      "/mcp",
      "/authorize",
      "/oauth/*",
      "/.well-known/*",
      "/connect",
    ],
  },
  // OAuth storage. The provider expects KV; the Worker adapts this D1
  // database to the KV interface (src/d1-kv.ts) because the deploy token has
  // D1 but not KV permissions. Bind OAUTH_KV instead to use KV directly.
  "d1_databases": [
    {
      "binding": "OAUTH_DB",
      "database_name": "palladian-oauth",
      "database_id": "3710b5b5-71cc-418c-8bf9-920608fabe54",
    },
  ],
  "vars": {
    // Production values; local development overrides them from .dev.vars.
    "PUBLIC_ORIGIN": "https://palladian.rdxx.workers.dev",
    "AGENT_JWT_ISSUER": "https://palladian.rdxx.workers.dev",
    "CONVEX_URL": "https://adamant-hound-861.convex.cloud",
  },
  // Secret (not in this file): AGENT_JWT_PRIVATE_KEY, the private ES256 JWK
  // as a JSON string. Set with `wrangler secret put AGENT_JWT_PRIVATE_KEY`.
  "observability": { "enabled": true },
}
