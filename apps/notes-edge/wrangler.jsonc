{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // One Worker at notes.parabolic.studio: the notes SPA (static assets), the
  // OAuth 2.1 authorization server for agent connections, and the MCP endpoint.
  "name": "palladian",
  "main": "src/index.ts",
  // The newest date the pinned wrangler/workerd (1.20260908.1) supports.
  "compatibility_date": "2026-09-08",
  // global_fetch_strictly_public: required by the OAuth provider for Client ID
  // Metadata Documents (SSRF protection on outbound metadata fetches).
  "compatibility_flags": ["global_fetch_strictly_public"],
  // The custom domain (D99) is the only address: passkeys, agent tokens and
  // Better Auth's trusted origin are all bound to it.
  "routes": [{ "pattern": "notes.parabolic.studio", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../notes/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the paths the Worker owns; everything else is served straight from assets.
    "run_worker_first": [
      "/mcp",
      "/authorize",
      "/oauth/*",
      "/.well-known/*",
      "/connect",
      "/internal/*",
    ],
  },
  // OAuth storage. The provider expects KV; the Worker adapts this D1
  // database to the KV interface (src/d1-kv.ts) because the deploy token has
  // D1 but not KV permissions. Bind OAUTH_KV instead to use KV directly.
  "d1_databases": [
    {
      "binding": "OAUTH_DB",
      "database_name": "palladian-oauth",
      "database_id": "3710b5b5-71cc-418c-8bf9-920608fabe54",
    },
  ],
  // Anonymous dynamic client registration: at most 10 per address per minute.
  "ratelimits": [
    {
      "name": "REGISTRATION_LIMIT",
      "namespace_id": "4101",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  // Account email (password reset, invitations) from the onboarded sender
  // domain; Convex hands messages to /internal/email (src/email.ts).
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["notes@parabolic.studio"],
    },
  ],
  // Daily removal of registrations that never completed an authorization.
  "triggers": { "crons": ["23 4 * * *"] },
  "vars": {
    // Production values; local development overrides them from .dev.vars.
    "PUBLIC_ORIGIN": "https://notes.parabolic.studio",
    "AGENT_JWT_ISSUER": "https://notes.parabolic.studio",
    "CONVEX_URL": "https://adamant-hound-861.convex.cloud",
    "EMAIL_FROM": "notes@parabolic.studio",
  },
  // Secrets (not in this file): AGENT_JWT_PRIVATE_KEY, the private ES256 JWK
  // as a JSON string, and EMAIL_RELAY_SECRET, shared with Convex. Set each
  // with `wrangler secret put <NAME>`.
  "observability": { "enabled": true },
}
