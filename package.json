{
  "name": "palladian",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p convex/tsconfig.json",
    "lint": "node scripts/check-boundaries.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:versions": "pnpm list --depth 0 && pnpm install --frozen-lockfile --strict-peer-dependencies",
    "check:auth-patches": "node scripts/check-auth-patch-source.mjs",
    "check": "pnpm typecheck && pnpm check:auth-patches && pnpm lint && pnpm test && pnpm build && pnpm check:bundle",
    "format:check": "prettier --check apps packages scripts tests convex --ignore-path .prettierignore playwright.config.ts tsconfig*.json package.json pnpm-workspace.yaml .github infra",
    "hosting:check": "wrangler deploy --dry-run --config infra/cloudflare/wrangler.jsonc",
    "test:auth:p1": "node tests/auth/p1.mjs && node tests/auth/origins.mjs && node tests/auth/stale-response.mjs && node tests/auth/stale-ui.mjs",
    "test:auth:resume": "node tests/auth/resume.mjs"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.12.5",
    "better-auth": "1.6.30",
    "convex": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@babel/parser": "8.0.4",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/node": "26.4.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "undici-types": "7.16.0",
    "vite": "8.2.2",
    "wrangler": "4.130.0"
  }
}
